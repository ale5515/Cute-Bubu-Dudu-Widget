{
  "name": "cute-pixel-widget",
  "version": "1.0.0",
  "description": "Desktop couple widget for Bubu and Dudu",
  "author": "Couple",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:bubu": "electron . --bubu",
    "server": "node server.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.couple.widgets",
    "productName": "CoupleWidgets",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.7.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale5515/Cute-Bubu-Dudu-Widget.git"
  },
  "keywords": [],
